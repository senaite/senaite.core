<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="senaite.core">

  <!-- Shadows the acquired `at_download` skin script from
       Products.Archetypes, which raises an AttributeError on content
       without an Archetypes schema. -->
  <browser:page
      for="*"
      name="at_download"
      class="senaite.core.browser.at_download.ATDownloadView"
      permission="zope2.View"
      layer="bika.lims.interfaces.IBikaLIMS"
      />

</configure>
