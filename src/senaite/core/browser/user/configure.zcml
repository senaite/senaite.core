<?xml version="1.0" encoding="utf-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser">

  <!-- Data manager adapter for our own user data schema.

       plone.app.users generates the profile schema at runtime and
       registers the adapter for that generated schema only. All
       generated schemas share the name
       "plone.supermodel.model.member-fields", and interfaces with
       the same name and module compare equal, so the registration
       of the registration form overwrites the one of the profile
       form. Fields copied into the generated schema keep working,
       but our "contact" field is not copied (plone's
       field_in_form only knows plone's own fields), so it keeps
       this interface and its lookup then fails with
       "Could not adapt". Registering it here makes the lookup
       independent of who registered last.
  -->
  <adapter
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      provides=".userdatapanel.IUserDataSchema"
      factory="plone.app.users.browser.userdatapanel.UserDataPanelAdapter"
      />

  <!-- Personal Preferences -->
  <browser:page
      name="personal-preferences"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class=".personalpreferences.PersonalPreferencesPanel"
      permission="cmf.SetOwnProperties"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Personal Information -->
  <browser:page
      name="personal-information"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class=".userdatapanel.UserDataPanel"
      permission="cmf.SetOwnProperties"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Password -->
  <browser:page
      name="change-password"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class=".passwordpanel.PasswordPanel"
      permission="cmf.SetOwnPassword"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- User Information (Controlpanel Configlet) -->
  <browser:page
      name="user-information"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class=".userdatapanel.UserDataConfiglet"
      permission="plone.app.controlpanel.UsersAndGroups"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

  <!-- Data Manager for Personal Preferences -->
  <adapter
      provides=".personalpreferences.IPersonalPreferences"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      factory=".personalpreferences.PersonalPreferencesPanelAdapter"
      />

  <!-- Data Manager for User Password -->
  <adapter
      provides=".passwordpanel.IPasswordSchema"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      factory=".passwordpanel.PasswordPanelAdapter"
      />

  <!-- New user form -->
  <browser:page
      name="new-user"
      for="plone.app.layout.navigation.interfaces.INavigationRoot"
      class=".register.AddUserForm"
      permission="plone.app.controlpanel.UsersAndGroups"
      layer="senaite.core.interfaces.ISenaiteCore"
      />

</configure>
