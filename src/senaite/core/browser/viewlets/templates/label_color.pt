<tal:block define="style view/chip_style"
           condition="style">
  <!--
    Restyle the Plone-rendered `.documentFirstHeading` to look like
    the Label's own colored chip. Scoped to the current portal type
    so the rule only applies on the Label view (and Plone tags the
    body with `portaltype-Label`).
  -->
  <style type="text/css"
         tal:content="string:
body.portaltype-Label .documentFirstHeading {
  display: inline-block;
  padding: .35rem .75rem;
  border-radius: 4px;
  font-size: 1.5rem;
  line-height: 1.2;
  ${style};
}">
  </style>
</tal:block>
