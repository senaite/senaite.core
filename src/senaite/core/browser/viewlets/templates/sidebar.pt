<nav id="sidebar"
     tal:define="klass python:view.is_navbar_toggled() and 'toggled' or 'minimized';"
     tal:condition="python:view.available()"
     tal:attributes="class string:${klass}; aria-expanded python:view.is_navbar_toggled() and 'true' or 'false'"
     role="navigation"
     aria-label="Main navigation"
     i18n:domain="senaite.core">

  <!-- Sidebar Header with Toggle Button -->
  <div id="sidebar-header">
    <button type="button"
            class="btn btn-link sidebar-toggle"
            aria-label="Toggle sidebar"
            i18n:attributes="aria-label">
      <span class="sidebar-toggle-icon"></span>
    </button>
  </div>

  <!-- Search Container -->
  <!-- <div id="sidebar-search-container">
       <input type="search"
       id="sidebar-search"
       class="form-control"
       placeholder="Search navigation..."
       aria-label="Search navigation"
       i18n:attributes="placeholder; aria-label" />
       </div>
  -->
  <!-- Navigation Container (populated by JavaScript) -->
  <div class="sidebar-navigation">
    <!-- Loading placeholder -->
    <div class="sidebar-loading">
      <div class="spinner"></div>
      <span i18n:translate="">Loading navigation...</span>
    </div>
  </div>

</nav>
