<configure
        xmlns="http://namespaces.zope.org/zope"
        xmlns:plone="http://namespaces.plone.org/plone"
        xmlns:browser="http://namespaces.zope.org/browser"
        i18n_domain="senaite.core">

  <browser:page
      for="senaite.core.interfaces.IWorksheets"
      name="view"
      class=".views.WorksheetsView"
      permission="cmf.ListFolderContents"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="view"
      class=".views.WorksheetView"
      permission="zope2.View"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <!-- Analyses Classic View -->
  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="analyses_classic_view"
      class=".views.AnalysesView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <!-- Analyses Transposed View -->
  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="analyses_transposed_view"
      class=".views.AnalysesTransposedView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <!-- Ajax signatures -->
  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="set_analyst"
      class=".ajax.SetAnalyst"
      permission="zope.Public"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="set_instrument"
      class=".ajax.SetInstrument"
      permission="zope.Public"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="add_analyses"
      class=".views.AddAnalysesView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="add_blank"
      class=".views.AddBlankView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="add_control"
      class=".views.AddControlView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="add_duplicate"
      class=".views.AddDuplicateView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheets"
      name="worksheet_add"
      class=".views.AddWorksheetView"
      permission="senaite.core.permissions.AddWorksheet"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="export"
      class=".views.ExportView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="print"
      class=".views.PrintView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <browser:page
      for="senaite.core.interfaces.IWorksheet"
      name="manage_results"
      class=".views.ManageResultsView"
      permission="senaite.core.permissions.ViewResults"
      layer="senaite.core.interfaces.ISenaiteCore"
  />

  <!-- Default worksheet layouts (classic and transposed view) -->
  <utility
      name="default_worksheet_layouts"
      factory=".utility.DefaultWorksheetLayouts"
      provides="senaite.core.interfaces.IWorksheetLayouts"
  />

  <plone:static
      directory="templates/print"
      type="worksheets"
      name="Worksheet Print Templates"
  />

</configure>

