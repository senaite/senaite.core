<?xml version="1.0" encoding="utf-8"?>
<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser">

  <browser:page
      for="senaite.core.content.labels.ILabels"
      name="labeled_objects"
      class=".labeled_objects.LabeledObjectsView"
      permission="senaite.core.permissions.ManageBika"
      layer="senaite.core.interfaces.ISenaiteCore"/>

  <browser:page
      for="senaite.core.interfaces.ICanHaveLabels"
      name="add_label"
      class=".manage_labels.AddLabelView"
      permission="senaite.core.permissions.ManageLabels"
      layer="senaite.core.interfaces.ISenaiteCore"/>

  <browser:page
      for="senaite.core.interfaces.ICanHaveLabels"
      name="remove_label"
      class=".manage_labels.RemoveLabelView"
      permission="senaite.core.permissions.ManageLabels"
      layer="senaite.core.interfaces.ISenaiteCore"/>

  <browser:page
      for="*"
      name="available_labels"
      class=".manage_labels.AvailableLabelsView"
      permission="senaite.core.permissions.ViewLabels"
      layer="senaite.core.interfaces.ISenaiteCore"/>

</configure>
