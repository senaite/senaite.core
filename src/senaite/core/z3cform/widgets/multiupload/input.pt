<div i18n:domain="senaite.core"
     class="multiuploadfield"
     tal:attributes="data-id view/id;
                     data-name view/name;
                     data-portal-url view/portal_url;
                     data-context-url view/context_url;
                     data-max-filesize string:104857600;
                     data-accepted-types string:{}">
  <!-- React widget will be rendered here by the renderer -->

  <!-- The hidden input field provides the field value before the widget is rendered.
       This is necessary if e.g. a JS requires the value directly after DOM loaded event -->
  <input type="hidden"
         tal:attributes="name python:view.name;
                         value python:'\r\n'.join(view.get_value())" />
</div>
