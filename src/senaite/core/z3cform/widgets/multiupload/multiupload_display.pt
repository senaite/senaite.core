<div i18n:domain="senaite.core"
     tal:define="value view/value;
                 portal_url context/@@plone_portal_state/portal_url">

  <!-- Include CSS for consistent styling -->
  <link rel="stylesheet"
        tal:attributes="href string:${portal_url}/++resource++senaite.core.z3cform.widgets.multiupload/multiupload_widget.css" />

  <div class="multi-upload-display" tal:condition="value">
    <div class="multi-upload-file-list">
      <tal:block tal:repeat="file value">
        <div class="multi-upload-file-item">
          <div class="file-info">
            <span class="file-icon">📎</span>
            <span class="file-name" tal:content="file/filename">filename.pdf</span>
            <span class="file-size" tal:content="python: '({:,.1f} KB)'.format(file.getSize() / 1024.0)">100 KB</span>
          </div>
          <div class="file-actions">
            <a tal:attributes="href string:${context/absolute_url}/@@download_attachment?file=${repeat/file/index}"
               class="file-download-link"
               target="_blank">
              Download
            </a>
          </div>
        </div>
      </tal:block>
    </div>
  </div>

  <div class="multi-upload-display-empty" tal:condition="not: value">
    <span class="no-files-message">No files attached</span>
  </div>

  <style>
    .multi-upload-display {
      margin: 10px 0;
    }

    .multi-upload-file-list {
      border: 1px solid #ddd;
      border-radius: 4px;
      background: #fff;
    }

    .multi-upload-file-item {
      padding: 10px 15px;
      border-bottom: 1px solid #eee;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .multi-upload-file-item:last-child {
      border-bottom: none;
    }

    .multi-upload-file-item:hover {
      background: #f9f9f9;
    }

    .multi-upload-file-item .file-info {
      display: flex;
      align-items: center;
      flex: 1;
    }

    .multi-upload-file-item .file-icon {
      font-size: 20px;
      margin-right: 10px;
    }

    .multi-upload-file-item .file-name {
      font-size: 14px;
      font-weight: 500;
      margin-right: 10px;
      color: #333;
    }

    .multi-upload-file-item .file-size {
      font-size: 12px;
      color: #999;
    }

    .multi-upload-file-item .file-actions {
      white-space: nowrap;
    }

    .multi-upload-file-item .file-download-link {
      display: inline-block;
      padding: 5px 12px;
      font-size: 12px;
      color: #337ab7;
      text-decoration: none;
      border: 1px solid #337ab7;
      border-radius: 3px;
      transition: all 0.2s;
    }

    .multi-upload-file-item .file-download-link:hover {
      background-color: #337ab7;
      color: #fff;
    }

    .multi-upload-display-empty {
      padding: 15px;
      text-align: center;
      color: #999;
      font-style: italic;
      background: #f9f9f9;
      border: 1px solid #ddd;
      border-radius: 4px;
    }
  </style>

</div>
