<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="senaite.core">

  <!-- Multi-upload widget -->
  <adapter
      factory=".widget.MultiUploadWidgetFactory" />

  <adapter
      factory=".widget.MultiUploadDataConverter" />

  <!-- Widget input template -->
  <browser:page
      name="multiupload_input"
      for="*"
      class="senaite.core.z3cform.widgets.multiupload.widget.MultiUploadWidget"
      template="multiupload_input.pt"
      permission="zope.Public"
      />

  <!-- Upload handler for AJAX requests -->
  <browser:page
      name="multiupload_handler"
      for="*"
      class=".handler.MultiUploadHandler"
      permission="zope2.View"
      />

</configure>
