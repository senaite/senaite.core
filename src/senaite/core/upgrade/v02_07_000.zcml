<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup">

   <genericsetup:upgradeStep
      title="SENAITE.CORE 2.6.0: Move Calculations to Senaite setup"
      description="Migrate Calculations to Senaite setup"
      source="2701"
      destination="2702"
      handler=".v02_07_000.migrate_calculations_to_dx"
      profile="senaite.core:default"/>

  <genericsetup:upgradeStep
      title="SENAITE.CORE 2.7.0: Allow Analyst to create AutoImportLog"
      description="Fix Unauthorized Error on auto_import_results"
      source="2700"
      destination="2701"
      handler=".v02_07_000.import_rolemap"
      profile="senaite.core:default"/>

  <genericsetup:upgradeStep
      title="Upgrade to SENAITE.CORE 2.7.0"
      source="2659"
      destination="2700"
      handler=".v02_07_000.upgrade"
      profile="senaite.core:default"/>

</configure>
