<html xmlns:tal="http://xml.zope.org/namespaces/tal"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      i18n:domain="senaite.core">

  <metal:view_macro define-macro="view">
    <div metal:define-macro="textarea-field-view"
         tal:define="uid context/UID|nothing;
                     field field|python:context.Schema()[fieldName]"
         tal:attributes="id string:parent-fieldname-$fieldName-$uid"
         class="remarks-widget my-4">
      <div class="senaite-remarks-widget-input"
           tal:attributes="python:field.get_input_widget_attributes(context,request)">
        <!-- ReactJS controlled component -->
      </div>
    </div>
  </metal:view_macro>

  <metal:edit define-macro="edit">
    <metal:use use-macro="field_macro | context/widgets/field/macros/edit">
      <metal:fill fill-slot="widget_body">
        <tal:remarks
            tal:define="field field|python:context.Schema()[fieldName];
                        temporary python:'portal_factory' in
                                  context.absolute_url()">

          <!-- Temporary object (add form): keep a plain textarea so the value
               is captured on creation; React in-place editing needs a
               persisted object -->
          <textarea tal:condition="temporary"
                    class="form-control"
                    tal:attributes="name fieldName; id fieldName;"></textarea>

          <!-- Persisted object: mount the React widget -->
          <div tal:condition="not:temporary"
               class="senaite-remarks-widget-input my-4"
               tal:attributes="python:field.get_input_widget_attributes(context,request)">
            <!-- ReactJS controlled component -->
          </div>
        </tal:remarks>
      </metal:fill>
    </metal:use>
  </metal:edit>

  <metal:search define-macro="search">
    <metal:use use-macro="context/widgets/field/macros/edit">
      <metal:fill fill-slot="widget_body">
        <textarea class="form-control"
                  tal:attributes="name fieldName; id fieldName;"></textarea>
      </metal:fill>
    </metal:use>
  </metal:search>

</html>
